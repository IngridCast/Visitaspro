# Copia este archivo como .env y completa los valores.

PORT=3000

# Clave para firmar los tokens. Usa un valor largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Duración de la sesión (formato de jsonwebtoken: 8h, 7d, ...).
JWT_EXPIRES_IN=7d

# Orígenes permitidos (la URL de la PWA), separados por coma.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Archivo de la base de datos SQLite.
DB_PATH=./data/visitaspro.db

# Clave para que otras aplicaciones creen visitas de instalación y retiro
# (POST /integrations/visits con la cabecera X-Api-Key). Mínimo 24 caracteres.
INTEGRATION_API_KEY=
