{
  "name": "visitaspro-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch src/index.js",
    "create-user": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/create-user.js",
    "seed-agents": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/seed-agents.js",
    "seed-visits": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/seed-visits.js",
    "seed-assets": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/seed-assets.js",
    "seed-assigned-visits": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/seed-assigned-visits.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3"
  }
}
