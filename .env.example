# Copia este archivo como .env.local y completa los valores.

# URL del servidor de VisitasPro (carpeta server/), que valida usuario y contraseña.
# /api usa el proxy de Vite. En producción, configura /api hacia el servidor
# o indica aquí la URL HTTPS pública de la API.
VITE_API_URL=/api

# Registro de la app en Microsoft Entra ID (Azure AD), tipo "Single-page application".
VITE_AZURE_CLIENT_ID=
# ID del tenant, o "common" / "organizations" para permitir varias organizaciones.
VITE_AZURE_TENANT_ID=common
